<div class="form-page">
  <h1>Edit Profile</h1>
  <%= form_with model: @user, url: profile_path, method: :patch, class: "form-card" do |f| %>
    <% if @user.errors.any? %>
      <div class="error-box">
        <ul><% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
      </div>
    <% end %>
    <div class="form-group">
      <%= f.label :fname, "First Name" %>
      <%= f.text_field :fname, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :lname, "Last Name" %>
      <%= f.text_field :lname, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :email, "Email Address" %>
      <%= f.email_field :email, class: "form-control", required: true %>
    </div>
    <div class="form-actions">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
      <%= link_to "Cancel", profile_path, class: "btn btn-link" %>
    </div>
  <% end %>
</div>
