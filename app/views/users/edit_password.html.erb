<div class="form-page">
  <h1>Change Password</h1>
  <%= form_tag edit_password_path, method: :patch, class: "form-card" do %>
    <div class="form-group">
      <%= label_tag :current_password, "Current Password" %>
      <%= password_field_tag :current_password, nil, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= label_tag :password, "New Password" %>
      <%= password_field_tag :password, nil, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= label_tag :password_confirmation, "Confirm New Password" %>
      <%= password_field_tag :password_confirmation, nil, class: "form-control", required: true %>
    </div>
    <div class="form-actions">
      <%= submit_tag "Update Password", class: "btn btn-primary" %>
      <%= link_to "Cancel", profile_path, class: "btn btn-link" %>
    </div>
  <% end %>
</div>
