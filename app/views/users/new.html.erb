<div class="form-page">
  <h1>Create an Account</h1>
  <%= form_with model: @user, url: signup_path, class: "form-card" do |f| %>
    <% if @user.errors.any? %>
      <div class="error-box">
        <ul><% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
      </div>
    <% end %>
    <div class="form-group">
      <%= f.label :fname, "First Name" %>
      <%= f.text_field :fname, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :lname, "Last Name" %>
      <%= f.text_field :lname, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :email, "Email Address" %>
      <%= f.email_field :email, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :password_confirmation, "Confirm Password" %>
      <%= f.password_field :password_confirmation, class: "form-control", required: true %>
    </div>
    <div class="form-actions">
      <%= f.submit "Create Account", class: "btn btn-primary" %>
      <%= link_to "Already have an account?", login_path, class: "btn btn-link" %>
    </div>
  <% end %>
</div>
