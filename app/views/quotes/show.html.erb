<div class="quote-show">

  <div class="quote-card quote-card-large">

    <blockquote class="quote-text-large">
      "<%= @quote.qtext %>"
    </blockquote>

    <div class="quote-attribution">

      <div class="source-details">

        <strong>
          <%= @quote.source.full_name %>
        </strong>

        <% if @quote.source.byear.present? || @quote.source.dyear.present? %>

          <span class="life-years">
            <%= @quote.source.life_years %>
          </span>

        <% end %>

        <% if @quote.qyear.present? %>

          <span class="pub-year">
            Published: <%= @quote.qyear %>
          </span>

        <% end %>

        <% if @quote.source.bio.present? %>

          <p class="source-bio">
            <%= @quote.source.bio %>
          </p>

        <% end %>

      </div>

      <p class="quote-collector">

        Collected by

        <strong>
          <%= @quote.user.fname %>
        </strong>

      </p>

    </div>

    <% if @quote.qcom.present? %>

      <div class="quote-comment-box">

        <strong>Collector's note:</strong>

        <%= @quote.qcom %>

      </div>

    <% end %>

    <!-- Categories -->
    <div class="quote-categories">

      <strong>Categories:</strong>

      <% @quote.categories.each do |cat| %>

        <%= link_to cat.catname,
            search_path(category_id: cat.id),
            class: "cat-badge" %>

      <% end %>

    </div>
    <!-- Date Added and Visibility -->
     <div class="quote-meta-row">
      <span class="meta-item">
        <strong>Date Added:</strong> <%= @quote.created_at.strftime("%d %B %Y") %>
      </span>
      <span class="meta-item">
        <strong>Visibility:</strong>
        <span class="visibility-badge <%= @quote.ispublic? ? 'public' : 'private' %>">
          <%= @quote.ispublic? ? "Public" : "Private" %>
        </span>
      </span>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="page-actions">

    <% if logged_in? && (current_user == @quote.user || admin_user?) %>

      <%= link_to "Edit Quote",
          edit_quote_path(@quote),
          class: "btn btn-secondary" %>

      <!-- Custom Delete Popup Button -->
      <%= button_tag "Delete Quote",
          type: "button",
          class: "btn btn-danger",
          onclick: "document.getElementById('deleteModal').style.display='flex'" %>

    <% end %>

    <%= link_to "Back",
        "javascript:history.back()",
        class: "btn btn-back" %>

  </div>

</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="logout-modal">

  <div class="logout-modal-content">

    <h2>Delete Quote</h2>

    <p>Are you sure you want to delete this quote?</p>

    <div class="logout-modal-actions">

      <button type="button"
          class="modal-btn cancel-btn"
          onclick="document.getElementById('deleteModal').style.display='none'">

        Cancel

      </button>

      <%= form_with url: quote_path(@quote),
          method: :delete,
          local: true,
          style: "display:inline;" do %>

        <%= submit_tag "Delete",
            class: "modal-btn confirm-btn" %>

      <% end %>

    </div>

  </div>

</div>