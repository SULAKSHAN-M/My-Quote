<% if quote.errors.any? %>
  <div class="error-list">
    <strong>Please fix the following errors:</strong>
    <ul>
      <% quote.errors.full_messages.each do |m| %>
        <li><%= m %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="form-group">
  <%= f.label :qtext, "Quote Text" %>
  <%= f.text_area :qtext, required: true, placeholder: "Enter the philosophical quote..." %>
</div>

<div class="form-group">
  <%= f.label :source_id, "Source (Philosopher)" %>
  <%= f.select :source_id,
        options_from_collection_for_select(@sources, :id, :full_name, quote.source_id),
        { prompt: "— Select a source —" },
        required: true %>
  <small style="font-family:Arial,sans-serif;font-size:0.8rem;color:#888;">
    Don't see the philosopher? <%= link_to "Add a new source", new_source_path, target: "_blank" %>.
  </small>
</div>

<div class="form-group">
  <%= f.label :qyear, "Publication Year (optional)" %>
  <%= f.text_field :qyear, placeholder: "e.g. 380 BCE, 1781, unknown" %>
</div>

<div class="form-group">
  <%= f.label :qcom, "Your Comment (optional)" %>
  <%= f.text_area :qcom, placeholder: "Add a personal comment about this quote...", style: "min-height:70px;" %>
</div>

<div class="form-group">
  <label>
    Categories <span style="color:#c0392b;">*</span>
    <small style="font-weight:normal;color:#888;"> (select at least one)</small>
  </label>
  <div class="checkbox-group">
    <% @categories.each do |cat| %>
      <label>
        <%= check_box_tag "category_ids[]", cat.id,
              (@selected_category_ids.present? ? @selected_category_ids.map(&:to_s).include?(cat.id.to_s) : quote.categories.include?(cat)),
              id: "category_#{cat.id}" %>
        <%= cat.catname %>
      </label>
    <% end %>
  </div>
  <small style="font-family:Arial,sans-serif;font-size:0.8rem;color:#888;">
    Need a new category? <%= link_to "Add one here", new_category_path, target: "_blank" %>.
  </small>
</div>

<div class="form-group">
  <label>
    <%= f.check_box :ispublic %>
    Make this quote public (visible to all visitors)
  </label>
</div>
