<div class="page-header">
  <h1>User: <%= @user.full_name %></h1>
  <div class="header-actions">
    <%= link_to "Edit User", edit_admin_user_path(@user), class: "btn btn-secondary" %>
    <%= link_to "Back to Users", admin_users_path, class: "btn btn-link" %>
  </div>
</div>

<div class="profile-card">
  <p><strong>Name:</strong> <%= @user.full_name %></p>
  <p><strong>Email:</strong> <%= @user.email %></p>
  <p><strong>Account Type:</strong> <%= @user.is_admin? ? "Administrator" : "Standard User" %></p>
  <p><strong>Status:</strong> <span class="status-badge status-<%= @user.status.downcase %>"><%= @user.status %></span></p>
  <p><strong>Member since:</strong> <%= @user.created_at.strftime("%d %B %Y") %></p>
</div>

<h2>Quotes by <%= @user.fname %> (<%= @quotes.count %>)</h2>
<% if @quotes.any? %>
  <table class="data-table">
    <thead><tr><th>Quote</th><th>Source</th><th>Visibility</th><th>Added</th></tr></thead>
    <tbody>
      <% @quotes.each do |q| %>
        <tr>
          <td><%= link_to truncate(q.qtext, length: 70), quote_path(q) %></td>
          <td><%= q.source.full_name %></td>
          <td><span class="visibility-badge <%= q.ispublic? ? 'public' : 'private' %>"><%= q.ispublic? ? "Public" : "Private" %></span></td>
          <td><%= q.created_at.strftime("%d %b %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">No quotes.</p>
<% end %>
