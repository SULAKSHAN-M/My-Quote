<div class="page-header">
  <h1>User Management</h1>
  <%= link_to "Back to Dashboard", admin_dashboard_path, class: "btn btn-link" %>
</div>

<table class="data-table">
  <thead>
    <tr><th>Name</th><th>Email</th><th>Type</th><th>Status</th><th>Quotes</th><th>Actions</th></tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.full_name %></td>
        <td><%= user.email %></td>
        <td><%= user.is_admin? ? "Admin" : "Standard" %></td>
        <td><span class="status-badge status-<%= user.status.downcase %>"><%= user.status %></span></td>
        <td><%= user.quotes.count %></td>
        <td class="actions">
          <%= link_to "View", admin_user_path(user), class: "btn btn-sm" %>
          <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-sm btn-secondary" %>
          <% unless user == current_user %>
            <%= link_to "Delete", admin_user_path(user), data: { turbo_method: :delete, turbo_confirm: "Delete #{user.full_name}'s account?" }, class: "btn btn-sm btn-danger" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
