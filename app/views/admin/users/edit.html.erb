<div class="form-page">
  <h1>Edit User: <%= @user.full_name %></h1>
  <%= form_with model: [:admin, @user], class: "form-card" do |f| %>
    <% if @user.errors.any? %>
      <div class="error-box">
        <ul><% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
      </div>
    <% end %>

    <div class="profile-card">
      <p><strong>Name:</strong> <%= @user.full_name %></p>
      <p><strong>Email:</strong> <%= @user.email %></p>
    </div>

    <div class="form-group">
      <%= f.label :status, "Account Status" %>
      <%= f.select :status, ["Active", "Suspended", "Banned"], {}, { class: "form-control" } %>
      <small>Suspended/Banned users cannot log in.</small>
    </div>

    <div class="form-group">
      <label class="checkbox-label">
        <%= f.check_box :is_admin %>
        Grant Administrator Privileges
      </label>
      <small>Admins can manage users, categories and all content.</small>
    </div>

    <div class="form-actions">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_users_path, class: "btn btn-link" %>
    </div>
  <% end %>
</div>
