<div class="form-page">
  <h1>Log In</h1>
  <%= form_tag login_path, class: "form-card" do %>
    <div class="form-group">
      <%= label_tag :email, "Email Address" %>
      <%= email_field_tag :email, params[:email], class: "form-control", required: true, autofocus: true %>
    </div>
    <div class="form-group">
      <%= label_tag :password, "Password" %>
      <%= password_field_tag :password, nil, class: "form-control", required: true %>
    </div>
    <div class="form-actions">
      <%= submit_tag "Log In", class: "btn btn-primary" %>
      <%= link_to "Create an account", signup_path, class: "btn btn-link" %>
    </div>
  <% end %>
</div>
