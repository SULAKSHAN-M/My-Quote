<div class="form-page">
  <h1>Edit Source</h1>
  <%= form_with model: @source, class: "form-card" do |f| %>
    <% if @source.errors.any? %>
      <div class="error-box">
        <ul><% @source.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
      </div>
    <% end %>
    <div class="form-group">
      <%= f.label :fname, "First Name" %>
      <%= f.text_field :fname, class: "form-control", required: true %>
    </div>
    <div class="form-group">
      <%= f.label :lname, "Last Name (optional)" %>
      <%= f.text_field :lname, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :byear, "Birth Year (optional)" %>
      <%= f.text_field :byear, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :dyear, "Death Year (optional)" %>
      <%= f.text_field :dyear, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :bio, "Short Biography (optional)" %>
      <%= f.text_area :bio, class: "form-control", rows: 4 %>
    </div>
    <div class="form-actions">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
      <%= link_to "Cancel", source_path(@source), class: "btn btn-link" %>
    </div>
  <% end %>
</div>
