<% if source.errors.any? %>
  <div class="error-list">
    <strong>Please fix the following:</strong>
    <ul><% source.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  </div>
<% end %>

<div class="form-group">
  <%= f.label :fname, "First Name / Known Name" %>
  <%= f.text_field :fname, required: true, placeholder: "e.g. Socrates, Anonymous" %>
</div>
<div class="form-group">
  <%= f.label :lname, "Last Name (optional)" %>
  <%= f.text_field :lname, placeholder: "e.g. Aristotle has no last name" %>
</div>
<div class="form-group">
  <%= f.label :byear, "Birth Year (optional)" %>
  <%= f.text_field :byear, placeholder: "e.g. 470 BCE, 1724" %>
</div>
<div class="form-group">
  <%= f.label :dyear, "Death Year (optional)" %>
  <%= f.text_field :dyear, placeholder: "e.g. 399 BCE, 1804, leave blank if living" %>
</div>
<div class="form-group">
  <%= f.label :bio, "Short Biography (optional)" %>
  <%= f.text_area :bio, placeholder: "A brief description of the philosopher..." %>
</div>
